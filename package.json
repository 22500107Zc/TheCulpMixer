{
  "name": "kline",
  "version": "0.12.0",
  "private": false,
  "description": "The Culp Mixer \u2014 a proprietary 3D modelling application. 33-hour free trial, then $199/month. Runs in a browser tab or as a desktop app.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "start": "vite build && vite preview --port 4173 --open",
    "app": "npm run build && electron .",
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "app:dev": "vite build && electron .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.api.json",
    "test": "npm run check:workflows && npm run test:unit && npm run test:app",
    "test:unit": "esbuild tests/*.test.ts --bundle --platform=node --format=esm --outdir=.test-build --log-level=warning && node --test '.test-build/*.test.js'",
    "test:app": "node --test tests/app.test.mjs && node --test tests/journey.test.mjs && node --test tests/console.test.mjs && node --test tests/offline-accounts.test.mjs && node --test tests/offline.test.mjs && node --test tests/mobile.test.mjs",
    "check:workflows": "node tools/check-workflows.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "gltf-validator": "^2.0.0-dev.3.10",
    "playwright": "^1.63.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "keywords": [
    "3d",
    "modelling",
    "modeling",
    "mesh",
    "webgl",
    "webgl2",
    "editor",
    "blender",
    "gltf",
    "subdivision"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/22500107Zc/Kline.git"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.culpindustries.culpmixer",
    "productName": "The Culp Mixer",
    "executableName": "CulpMixer",
    "copyright": "Copyright \u00a9 2026 The Culp Mixer contributors",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "THIRD-PARTY-NOTICES.md",
      "licences/**/*"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "afterPack": "build/adhoc-sign.cjs",
    "fileAssociations": [
      {
        "ext": "kline",
        "name": "The Culp Mixer Scene",
        "description": "The Culp Mixer 3D scene",
        "role": "Editor",
        "icon": "build/icon.png"
      },
      {
        "ext": "kiln",
        "name": "The Culp Mixer Scene (legacy)",
        "description": "The Culp Mixer 3D scene saved before the rename",
        "role": "Editor",
        "icon": "build/icon-kiln.png"
      }
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "artifactName": "CulpMixer-${arch}.${ext}",
      "target": [
        {
          "target": "pkg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "darkModeSupport": true
    },
    "dmg": {
      "title": "The Culp Mixer ${arch}",
      "artifactName": "CulpMixer-${arch}.${ext}",
      "iconSize": 128,
      "window": {
        "width": 560,
        "height": 380
      },
      "contents": [
        {
          "x": 150,
          "y": 190,
          "type": "file"
        },
        {
          "x": 410,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "CulpMixer-portable.${ext}"
    },
    "nsis": {
      "artifactName": "CulpMixer-Setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "The Culp Mixer"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Graphics",
      "icon": "build/icon.png",
      "artifactName": "CulpMixer.${ext}",
      "desktop": {
        "StartupWMClass": "The Culp Mixer"
      },
      "maintainer": "The Culp Mixer contributors <noreply@users.noreply.github.com>"
    },
    "pkg": {
      "installLocation": "/Applications",
      "allowAnywhere": true,
      "allowCurrentUserHome": true,
      "isRelocatable": false,
      "overwriteAction": "upgrade"
    }
  },
  "author": {
    "name": "The Culp Mixer contributors",
    "email": "noreply@users.noreply.github.com"
  },
  "dependencies": {
    "onnxruntime-web": "^1.29.0"
  }
}
